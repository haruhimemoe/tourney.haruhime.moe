# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The app uses the "tourney"
# database and reads the haruhime.moe hub's "identity" database (users and sessions) on the same cluster. Its user
# must have readWrite on "tourney" and only read on "identity": tourney refuses to start when it can reach another
# database, or write to identity (see TOURNEY_ALLOW_SHARED_DB_USER below). Bracket saves use transactions, so the
# server must be a replica set (Atlas always is).
MONGODB_URI=

# The haruhime.moe hub's BETTER_AUTH_SECRET (the same value): tourney checks the hub's session cookie with it.
# Sign-in itself runs only on the hub.
BETTER_AUTH_SECRET=

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an example)
# and secret. tourney uses them for osu! API lookups (client credentials: player snapshots, mp links), not sign-in.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# osu! user ids with admin rights, comma-separated, like 1234567,7654321. Empty means nobody has them.
ADMIN_OSU_IDS=

# Where pools lives. Empty means https://pools.haruhime.moe.
POOLS_URL=

# The secret pools expects on its internal pool route (pools' TOURNEY_SERVICE_SECRET), at least 32 characters.
# Empty means tourney can't read linked pools.
TOURNEY_SERVICE_SECRET=

# Optional. "true" lets tourney run on a database user that reaches other databases too. The user still needs
# readWrite on "tourney", and tourney logs a warning naming the other databases. Empty keeps the strict check.
TOURNEY_ALLOW_SHARED_DB_USER=

# Optional. "true" shows a small "beta" tag beside the tourney wordmark on every page. Next.js reads it when it
# builds the site, so a change needs a new build.
NEXT_PUBLIC_TOURNEY_BETA=

# The haruhime.moe hub: sign-in, the account page and session refreshes. Empty means https://www.haruhime.moe.
HUB_URL=

# Optional. The hub's account export/delete fan-out (/api/internal/account/*) sends it as a Bearer token:
# the same value as the hub's ACCOUNT_SECRET_TOURNEY. At least 32 characters. Generate one with:
# openssl rand -base64 32. Empty means those routes refuse every call.
ACCOUNT_FANOUT_SECRET=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
